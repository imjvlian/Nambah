# Supabase — dedicated Nambah project.
# Server-side database access used by catalog/pricing repositories.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Supabase Auth for customer accounts. The publishable key is safe for browser
# distribution, but Nambah currently proxies auth through server routes and
# stores sessions in HttpOnly cookies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local `next dev` enables flow-test automatically. Set true on a deployed test
# environment, or false locally when you want strict real Digiflazz SKU pricing.
NAMBAH_FLOW_TEST_MODE=

# Fulfillment safety. If NAMBAH_FULFILLMENT_MODE is empty, Nambah defaults to
# "simulate" while flow-test mode is active and "disabled" otherwise.
# Allowed: disabled | simulate | digiflazz-test | digiflazz-live
NAMBAH_FULFILLMENT_MODE=
# Local simulation never contacts Digiflazz. Allowed: success | failed | pending
NAMBAH_SIMULATED_FULFILLMENT_OUTCOME=success
# Digiflazz testing:true outcome. No real supplier balance is spent.
# Allowed: success | failed | pending-success | pending-failed
NAMBAH_DIGIFLAZZ_TEST_OUTCOME=success
# Extra production kill-switch. Live fulfillment remains blocked until Nambah
# has an explicit customer_no format per game/product; never enable by accident.
NAMBAH_ALLOW_LIVE_FULFILLMENT=false
# Second live-money gate. Set exactly this value only after SKU/target templates,
# Midtrans production and supplier balance controls are verified.
NAMBAH_LIVE_FULFILLMENT_ACK=

# Admin browser sessions are signed with this secret. Generate a long random
# server-only value. If empty, NAMBAH_ADMIN_API_TOKEN is used as legacy fallback.
NAMBAH_ADMIN_SESSION_SECRET=

# Legacy bearer/recovery token for internal admin API access. Browser admin
# login now uses a normal Nambah account + admin_users role instead.
NAMBAH_ADMIN_API_TOKEN=

# Secret for periodic monitor/reconciliation endpoints. Vercel Cron sends this
# as Authorization: Bearer <CRON_SECRET>. Keep server-only.
CRON_SECRET=

# Volsever Game ID Checker — primary account checker.
# Create an API key in the Volsever dashboard. Keep it server-only.
# Never prefix this value with NEXT_PUBLIC_.
VOLSEVER_API_KEY=

# Mimih Market / Gempay API H2H — Mobile Legends nickname + region fallback.
# Create a production H2H key, activate the Region API package, and whitelist
# the same public server IP on both the H2H key and the Region API package.
# Keep both values server-only; never prefix them with NEXT_PUBLIC_.
GEMPAY_API_USERNAME=
GEMPAY_API_SECRET=

# Digiflazz Buyer API. Never expose these with NEXT_PUBLIC_.
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_WEBHOOK_SECRET=

# Optional public callback URL, e.g. https://domain-kamu.com/api/webhooks/digiflazz
DIGIFLAZZ_CALLBACK_URL=

# Telegram admin alerts. Server-only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Order access does not use a global secret. Each order receives a random opaque
# token; only its SHA-256 hash is persisted in the database.

# Midtrans Sandbox. Never expose the Server Key.
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=


# Brevo transactional email receipt.
# Register/verify the sender in Brevo before enabling. Receipt email is sent
# only after an order reaches success. Keep the API key server-only.
BREVO_RECEIPT_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Nambah

# Optional universal game-account checker routing.
# JSON object maps Nambah game id -> Volsever route slug.
# Mobile Legends keeps its built-in mobile-legends-wr route.
# Example: {"some-game-id":"provider-route-slug"}
VOLSEVER_GAME_ROUTES_JSON=

# Optional but recommended privacy salt for durable abuse/rate-limit keys.
# Generate a long random server-only value. Never expose with NEXT_PUBLIC_.
NAMBAH_RATE_LIMIT_SECRET=
