# Supabase — dedicated Nambah project.
# Server-side database access used by catalog/pricing repositories.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Reserved for Supabase Auth/client features in later milestones.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local `next dev` enables flow-test automatically. Set true on a deployed test
# environment, or false locally when you want strict real Digiflazz SKU pricing.
NAMBAH_FLOW_TEST_MODE=

# Internal admin API guard. Generate a long random value and keep it server-only.
NAMBAH_ADMIN_API_TOKEN=

# Secret for periodic monitor endpoints. Keep server-only.
CRON_SECRET=

# Mimih Market / Gempay API H2H — Mobile Legends nickname + region checker.
# Create a production H2H key, activate the Region API package, and whitelist
# the same public server IP on both the H2H key and the Region API package.
# Keep both values server-only; never prefix them with NEXT_PUBLIC_.
GEMPAY_API_USERNAME=
GEMPAY_API_SECRET=

# Digiflazz Buyer API. Never expose these with NEXT_PUBLIC_.
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_WEBHOOK_SECRET=

# Optional public callback URL, e.g. https://domain.com/api/webhooks/digiflazz
DIGIFLAZZ_CALLBACK_URL=

# Telegram admin alerts. Server-only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Midtrans Sandbox only in 0.3.x. Never expose the Server Key.
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
