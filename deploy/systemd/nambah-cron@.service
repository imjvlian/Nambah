# Template unit untuk satu job cron Nambah.
#
# JANGAN langsung meng-install file ini. Jalankan `install-timers.sh`, yang
# akan me-render ulang file ini dengan `ExecStart` dan `Documentation` yang
# mengikuti lokasi repo (`APP_DIR`). Nilai di bawah adalah default untuk repo
# yang berada di /opt/nambah.
#
# `ProtectHome=read-only`, bukan `true`: repo Nambah pada sebagian mesin ada di
# direktori home user, dan `true` membuat systemd menutup akses ke /home
# sepenuhnya sehingga ExecStart tidak bisa dibaca.

[Unit]
Description=Nambah cron job (%i)
Documentation=file:///opt/nambah/deploy/systemd/README.md
After=network-online.target
Wants=network-online.target

# Cron job TIDAK di-restart otomatis.
#
# `Restart=on-failure` pernah dipakai di sini dan itu salah: sebuah endpoint
# yang membalas 400 (secret salah, env rusak) tidak akan pernah berhasil dengan
# dicoba ulang. Unit itu mencoba lagi setiap 30 detik tanpa henti, memenuhi
# journal, dan membuat unit aslinya tidak terlihat di `systemctl list-units
# --failed` karena restart terus mengeset ulang statusnya.
#
# Sekarang kegagalan sekali tercatat, lalu job menunggu jadwal berikutnya.
# Kalau memang perlu dicoba ulang setelah masalah beres, `systemctl start`
# manual atau timer pada jadwal berikutnya sudah cukup.

[Service]
Type=oneshot
EnvironmentFile=/etc/nambah/cron.env
ExecStart=/opt/nambah/deploy/systemd/nambah-cron-run.sh %i

# `reconcile` menjalankan retry supplier dan receipt, `telegram-dispatch`
# menunggu jeda 1,1 detik per pesan, jadi run-nya bisa beberapa puluh detik.
TimeoutStartSec=420
Restart=no

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only