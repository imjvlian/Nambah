[Unit]
Description=Nambah cron job (%i)
Documentation=file:///opt/nambah/deploy/systemd/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/nambah/cron.env
ExecStart=/opt/nambah/deploy/systemd/nambah-cron-run.sh %i
# Cron sometimes butuh waktu lama: reconcile menjalankan retry supplier dan
# receipt, telegram-dispatch menunggu jeda 1,1 detik per pesan.
TimeoutStartSec=420
# Retry sekali kalau failure-nya kelihatan sementara (network, restart Supabase).
Restart=on-failure
RestartSec=30
# Cegah dua job yang sama berjalan bersamaan kalau satu run melar.
TimeoutStopSec=30

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true